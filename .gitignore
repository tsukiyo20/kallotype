# Build output
/target/

# Rendered images — regenerate with `kalo render`
/out/

# A cargo home kept inside the tree, used only when the system one is
# unavailable (sandboxes, CI images without a writable ~/.cargo).
/.cargo-home/

# The research this model is built on: the manufacturer data sheets, the
# digitised curves, the extractors, and the design notes. Kept locally because
# the published repository is the code, and because the data sheets are not ours
# to redistribute. `private/README.md` says what is in there and why.
/private/

# Compiled Python from the scripts in scripts/
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Rust backup files left by some editors
*.rs.bk
