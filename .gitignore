# Build output
/target/

# Rendered images — regenerate with `kalo render`
/out/

# A cargo home kept inside the tree, used only when the system one is
# unavailable (sandboxes, CI images without a writable ~/.cargo).
/.cargo-home/

# Camera sensitivities are imported locally: the source database is
# CC BY-NC-SA, so it is not vendored. See data/cameras/README.md.
/data/cameras/*.csv

# Compiled Python from the scripts in scripts/
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Rust backup files left by some editors
*.rs.bk
