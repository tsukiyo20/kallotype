# Build output
/target/

# Rendered images — regenerate with `kalo render`
/out/

# A cargo home kept inside the tree, used only when the system one is
# unavailable (sandboxes, CI images without a writable ~/.cargo).
/.cargo-home/

# Research notes, datasets and the tooling that ingests them are kept locally.
# The published repository is the code; see README.md for what they contain.
/docs/
/data/
/scripts/
/ROADMAP.md
/CHANGELOG.md
/NOTICE.md
/CONTRIBUTING.md

# Camera sensitivities are imported locally: the source database is
# CC BY-NC-SA, so it is not vendored.
/data/cameras/*.csv

# Compiled Python from the scripts in scripts/
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Rust backup files left by some editors
*.rs.bk
